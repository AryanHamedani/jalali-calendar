#!/usr/bin/env python3
"""Bring the event data in step with time.ir, by way of holidayapi.ir.

    bin/fetch-events 1405 1406

Most occasions never need fetching: solar and Gregorian dates repeat every
year, and lunar ones repeat on their Hijri date. What changes is when each
Hijri month begins, which Iran fixes by sighting the moon. For each year
asked for, this

  - records the day every Hijri month began in events/hijri-months.json,
    read off the dates time.ir gives its lunar occasions;
  - writes into events/once.json any holiday time.ir has that the lists
    don't explain (or a listed one it drops), for that date only;
  - prints, as Markdown, every time.ir occasion the bundled lists don't hold
    and events/skipped.json doesn't set aside, to be added by hand with its
    English title. Nothing is guessed.
"""
from concurrent.futures import ThreadPoolExecutor
import difflib
import json
from pathlib import Path
import re
import sys
import time
import urllib.request

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lib'))
import jalali  # noqa: E402

EVENTS = ROOT / 'events'
API = 'https://holidayapi.ir/jalali/%d/%02d/%02d'
# The service turns away Python's default agent.
AGENT = 'jalali-calendar (+https://github.com/AryanHamedani/jalali-calendar)'
DIGITS = str.maketrans('۰۱۲۳۴۵۶۷۸۹', '0123456789')
SOLAR = ['فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور', 'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند']
LUNAR = ['محرم', 'صفر', 'ربیع الاول', 'ربیع الثانی', 'جمادی الاول', 'جمادی الثانیه',
         'رجب', 'شعبان', 'رمضان', 'شوال', 'ذوالقعده', 'ذوالحجه']


def get(jy, jm, jd):
    for attempt in range(5):
        try:
            request = urllib.request.Request(API % (jy, jm + 1, jd), headers={'User-Agent': AGENT})
            with urllib.request.urlopen(request, timeout=30) as response:
                return json.load(response)
        except (OSError, ValueError):
            if attempt == 4:
                raise
            time.sleep(2 ** attempt)


def fetch_year(jy):
    days = [(jy, m, d) for m in range(12) for d in range(1, jalali.month_length(jy, m) + 1)]
    with ThreadPoolExecutor(8) as pool:
        return list(zip(days, pool.map(lambda day: get(*day), days)))


def key(text):
    """A title with spacing, punctuation and digit script taken out, for matching."""
    text = text.translate(DIGITS).replace('ي', 'ی').replace('ك', 'ک')
    return re.sub(r'[\s‌‎‏،؛,;:/\\\-\[\]()«»"\'.ـ]+|[ً-ْ]', '', text)


def same(a, b):
    a, b = key(a), key(b)
    return a == b or bool(a and b and (a in b or b in a)) or difflib.SequenceMatcher(None, a, b).ratio() > 0.75


def label(event):
    """(kind, month, day, year) from an event's date line, e.g. '۱۰ محرم'."""
    text = re.sub(r'\s+', ' ', event['additional_description']).strip().replace('اَمرداد', 'مرداد')
    if m := re.fullmatch(r'([۰-۹]+) (.+?)(?: (\d+))?', text):
        day, month, year = int(m.group(1).translate(DIGITS)), m.group(2), int(m.group(3) or 0)
        if month in SOLAR:
            return ('history' if year else 'solar'), SOLAR.index(month), day, year
        if month in LUNAR:
            return 'lunar', LUNAR.index(month), day, 0
    if (m := re.fullmatch(r'([A-Z][a-z]+) (\d+)(?: (\d+))?', text)) and m.group(1) in jalali.GREGORIAN_MONTHS:
        year = int(m.group(3) or 0)
        return 'gregorian', jalali.GREGORIAN_MONTHS.index(m.group(1)), int(m.group(2)), 0 if year == 1900 else year
    return None


def main(years):
    path = EVENTS / 'hijri-months.json'
    table = json.loads(path.read_text())
    once = json.loads((EVENTS / 'once.json').read_text())
    try:
        fetched = {jy: fetch_year(jy) for jy in years}
    except (OSError, ValueError) as error:  # nothing has been written yet
        sys.exit('fetch-events: could not read holidayapi.ir (%s); no file was changed' % error)

    # Each lunar occasion names its Hijri date, so its day fixes its month's
    # first day. "The 30th" means the month's last day, so it fixes nothing.
    starts = {}
    for days in fetched.values():
        for (jy, jm, jd), data in days:
            for event in data['events']:
                kind, month, day, _ = label(event) or (None,) * 4
                if kind == 'lunar' and day < 30:
                    starts[jalali.jalali_to_jdn(jy, jm, jd) - day + 1] = month
    report = []
    known = {row['jdn']: '%d-%02d' % (row['year'], row['month'] + 1) for row in jalali.hijri_month_table(table)}
    for jdn, month in sorted(starts.items()):
        # Name the month by its neighbour in the table; the table is the anchor.
        name = next((n for j, n in known.items() if abs(j - jdn) < 20 and int(n[-2:]) == month + 1), None)
        if name is None:
            prev = max((j for j in known if j < jdn), default=None)
            # A month time.ir gives no occasion for leaves a gap: the table
            # stops short of it, and says so, rather than the whole sync failing.
            if prev is None or not 29 <= jdn - prev <= 30 or int(known[prev][-2:]) % 12 != month:
                gy, gm, gd = jalali.d2g(jdn)
                report.append('- Hijri month %d starting %04d-%02d-%02d not placed: the month before it has no known start'
                              % (month + 1, gy, gm + 1, gd))
                continue
            year, last = map(int, known[prev].split('-'))
            name = '%d-%02d' % (year + (last == 12), last % 12 + 1)
        known = {j: n for j, n in known.items() if n != name}
        known[jdn] = name
    rows = sorted(known.items())
    for (a, _), (b, name) in zip(rows, rows[1:]):
        if not 29 <= b - a <= 30:
            sys.exit('fetch-events: Hijri month %s would be %d days long' % (name, b - a))
    table = {name: '%04d-%02d-%02d' % (gy, gm + 1, gd) for jdn, name in rows for gy, gm, gd in [jalali.d2g(jdn)]}
    path.write_text(json.dumps(dict(sorted(table.items())), ensure_ascii=False, indent=1) + '\n')

    # Holidays the yearly lists don't give, or give where time.ir has none.
    for jy in years:
        for name in [n for n in once if n.startswith('%d-' % jy)]:
            once[name].pop('holiday', None)
            if not once[name]:
                del once[name]
    events = jalali.load_events(EVENTS, english=False)
    events['hijriMonths'] = jalali.hijri_month_table(table)
    events['once'] = once
    skipped = {key(t) for t in json.loads((EVENTS / 'skipped.json').read_text())['titles']}
    for days in fetched.values():
        for (jy, jm, jd), data in days:
            cell = jalali.day_cell(jalali.jalali_to_jdn(jy, jm, jd), events)
            date = '%d-%02d-%02d' % (jy, jm + 1, jd)
            if cell['holiday'] != data['is_holiday']:
                once.setdefault(date, {})['holiday'] = data['is_holiday']
                report.append('- %s: time.ir says %s holiday; kept in once.json' % (date, 'a' if data['is_holiday'] else 'no'))
            history = [t for _, t in jalali.on_this_day(events, (jy, jm, jd), cell['gregorian'], 'fa')]
            for event in data['events']:
                kind = (label(event) or ('none',))[0]
                title = re.sub(r'\s+', ' ', event['description']).strip()
                if title == 'جمعه' or key(title) in skipped or any(same(title, t) for t in cell['occasions'] + history):
                    continue
                report.append('- %s (%s): %s — `%s`' % (date, kind, title, event['additional_description'].strip()))
    (EVENTS / 'once.json').write_text(json.dumps(dict(sorted(once.items())), ensure_ascii=False, indent=1) + '\n')

    # The test fixture is time.ir's own holiday list; refresh the years fetched
    # so a revised moon sighting doesn't fail the tests with the new data.
    fixture_path = ROOT / 'tests' / 'timeir-holidays.json'
    fixture = json.loads(fixture_path.read_text())
    first, last = fixture['years']
    if first - 1 <= min(years) and max(years) <= last + 1:
        holidays = {d for d in fixture['holidays'] if int(d[:4]) not in years}
        holidays |= {'%d-%02d-%02d' % (jy, jm + 1, jd) for days in fetched.values() for (jy, jm, jd), data in days
                     if data['is_holiday'] and jalali.weekday_of_jdn(jalali.jalali_to_jdn(jy, jm, jd)) != 5}
        fixture.update(years=[min(first, *years), max(last, *years)], holidays=sorted(holidays))
        fixture_path.write_text(json.dumps(fixture, ensure_ascii=False, indent=0))
    if report:
        print('\n'.join(report))


if __name__ == '__main__':
    if len(sys.argv) < 2 or not all(a.isdigit() for a in sys.argv[1:]):
        sys.exit(__doc__.strip())
    main([int(a) for a in sys.argv[1:]])
