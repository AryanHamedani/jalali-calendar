#!/usr/bin/env python3
"""The Persian (Jalali) calendar, for a terminal or a desktop bar.

    jalali-calendar                     today, e.g. Friday 8 Aban 1405
    jalali-calendar date [FORMAT]       now, in a format (see the README)
    jalali-calendar convert DATE        2026-10-30 <-> 1405-08-08 (years before 1700 are Jalali)
    jalali-calendar month [YEAR MONTH]  a month in the terminal, holidays in red
    jalali-calendar waybar              label and calendar tooltip as one JSON line
    jalali-calendar shift -1|+1|0       step the tooltip's month; 0 goes back to today

Options, anywhere on the line:
    --language en|fa          English (default) or Persian, right to left
    --week-start DAY          saturday (default), monday, sunday, …
    --format FORMAT           label for `waybar` (default: dddd d MMMM HH:mm)
    --holiday-color COLOR     tooltip color for Fridays and holidays (default #f7768e)
    --today-color COLOR       tooltip highlight for today (default #7aa2f7)
"""
from datetime import date, datetime
import html
import os
from pathlib import Path
import re
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'lib'))
import jalali  # noqa: E402


def esc(text):
    return html.escape(str(text), quote=False)

EVENTS = ROOT / 'events'
RLM, LRE, PDF = '\u200f', '\u202a', '\u202c'


def private_dir():
    """XDG_RUNTIME_DIR, or a 0700 folder in ~/.cache: never a world-writable /tmp,
    where another user could plant a symlink for us to write through."""
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if runtime and os.path.isdir(runtime):
        return Path(runtime)
    path = Path(os.environ.get('XDG_CACHE_HOME', Path.home() / '.cache')) / 'jalali-calendar'
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    return path


OFFSET = private_dir() / 'jalali-calendar.offset'
# A month stepped to by scrolling snaps back to today once the pointer has
# been gone this long, the way a calendar popup resets when it closes.
OFFSET_TTL = 120


def parse_options(argv):
    opts = {'language': 'en', 'week-start': 'saturday', 'format': 'dddd d MMMM HH:mm',
            'holiday-color': '#f7768e', 'today-color': '#7aa2f7'}
    args, i = [], 0
    while i < len(argv):
        if argv[i].startswith('--') and argv[i][2:] in opts:
            if i + 1 >= len(argv):
                sys.exit('jalali-calendar: %s needs a value' % argv[i])
            opts[argv[i][2:]] = argv[i + 1]
            i += 2
        else:
            args.append(argv[i])
            i += 1
    opts['language'] = jalali.lang(opts['language'])
    return args, opts


def events_for(jy, language):
    return jalali.load_events(EVENTS, years=(jy - 1, jy, jy + 1), english=language == 'en')


def day_title(cell, language):
    return jalali.localize_digits('%s %d %s %d' % (jalali.WEEKDAYS[language][cell['weekday']], cell['day'],
                                                   jalali.MONTHS[language][cell['month']], cell['year']), language)


def gregorian_title(cell):
    gy, gm, gd = cell['gregorian']
    return '%d %s %d' % (gd, jalali.GREGORIAN_MONTHS[gm], gy)


def month_view(jy, jm, opts, today):
    """Rows of the month grid as (week, [cells]) in display order, and the header."""
    language = opts['language']
    events = events_for(jy, language)
    weeks = jalali.month_grid(jy, jm, opts['week-start'], events, jalali.jdn_of(today))
    order = jalali.WEEKDAY_SHORT[language]
    heads = [order[c['weekday']] for c in weeks[0]['days']]
    title = jalali.localize_digits('%s %d' % (jalali.MONTHS[language][jm], jy), language)
    span = [c['gregorian'] for w in weeks for c in w['days'] if c['inMonth']]
    gregorian = '%s %d – %s %d' % (jalali.GREGORIAN_MONTHS[span[0][1]][:3], span[0][0],
                                   jalali.GREGORIAN_MONTHS[span[-1][1]][:3], span[-1][0])
    if span[0][0] == span[-1][0]:
        gregorian = '%s – %s %d' % (jalali.GREGORIAN_MONTHS[span[0][1]][:3], jalali.GREGORIAN_MONTHS[span[-1][1]][:3], span[0][0])
    return title, gregorian, heads, weeks, events


def cell_text(cell, language, rtl=False, width=3):
    # Right to left, the padding goes after the digits to land on their left.
    text = str(cell['day'])
    return jalali.localize_digits(text.ljust(width) if rtl else text.rjust(width), language)


def terminal_month(jy, jm, opts):
    language = opts['language']
    title, gregorian, heads, weeks, _ = month_view(jy, jm, opts, date.today())
    color = sys.stdout.isatty() and not os.environ.get('NO_COLOR')
    paint = (lambda codes, text: '\x1b[%sm%s\x1b[0m' % (codes, text)) if color else (lambda codes, text: text)
    rtl = language == 'fa'
    out = [(title + '  ' + gregorian).center(4 * 7 + 4).rstrip()]
    head = [h[:2].rjust(3) if language == 'en' else h.rjust(3) for h in heads]
    out.append('   ' + ' '.join(reversed(head) if rtl else head))
    footnotes = []
    for week in weeks:
        cells = []
        for cell in week['days']:
            codes = ';'.join(c for c in ('2' if not cell['inMonth'] else '', '31' if cell['holiday'] else '',
                                          '7' if cell['today'] else '') if c)
            text = cell_text(cell, language)
            cells.append(paint(codes, text) if codes else text)
            if cell['inMonth'] and cell['occasions'] and (cell['holiday'] and not cell['weekend'] or cell['today']):
                footnotes.append((cell, cell['occasions']))
        number = jalali.localize_digits(str(week['week']).rjust(2), language)
        out.append(paint('2', number) + ' ' + ' '.join(reversed(cells) if rtl else cells))
    for cell, titles in footnotes:
        mark = paint('31', '%3s' % jalali.localize_digits(cell['day'], language)) if cell['holiday'] else '%3s' % jalali.localize_digits(cell['day'], language)
        out.append('%s  %s' % (mark, ' · '.join(titles)))
    print('\n'.join(out))


def read_offset():
    try:
        if time.time() - OFFSET.stat().st_mtime > OFFSET_TTL:
            return 0
        return int(OFFSET.read_text().strip() or 0)
    except (OSError, ValueError):
        return 0


def waybar(opts, now=None):
    now = now or datetime.now()
    language = opts['language']
    jy, jm, _ = jalali.jalali_for(now)
    offset = read_offset()
    vy, vm = jalali.step_month(jy, jm, offset)
    title, gregorian, heads, weeks, events = month_view(vy, vm, opts, now.date())
    rtl = language == 'fa'
    # Pango lays out each line with the Unicode bidi algorithm, so a Persian
    # grid is written in reading order, Saturday first, and every line is
    # marked right to left; Latin text inside stays a left-to-right island.
    line = (lambda text: RLM + text) if rtl else (lambda text: text)
    ltr = (lambda text: LRE + text + PDF) if rtl else (lambda text: text)
    gutter = '   ' if rtl else ' '  # right to left, cells pad on the far side
    holiday_color = html.escape(opts['holiday-color'], quote=True)
    today_color = html.escape(opts['today-color'], quote=True)

    def span(cell):
        text = esc(cell_text(cell, language, rtl))
        if cell['today']:
            return '<span background="%s" color="#1a1b26"><b>%s</b></span>' % (today_color, text)
        if not cell['inMonth']:
            return '<span alpha="35%%">%s</span>' % text
        if cell['holiday']:
            return '<span color="%s">%s</span>' % (holiday_color, text)
        return text

    def head(i, h):
        label = h[:2].rjust(3) if language == 'en' else h.ljust(3)
        return '<span color="%s">%s</span>' % (holiday_color, esc(label)) if weeks[0]['days'][i]['weekend'] else esc(label)

    head_cells = [head(i, h) for i, h in enumerate(heads)]
    lines = [line('<b>%s</b>  <span alpha="60%%">%s</span>' % (esc(title), ltr(gregorian))),
             '<tt>' + line('<span alpha="50%">  </span>' + gutter + ' '.join(head_cells))]
    for week in weeks:
        cells = [span(c) for c in week['days']]
        number = '<span alpha="50%%">%s</span>' % esc(jalali.localize_digits(str(week['week']).rjust(2), language))
        lines.append(line(number + gutter + ' '.join(cells)))
    lines[-1] += '</tt>'

    today_cell = jalali.day_cell(jalali.jdn_of(now.date()), events_for(jy, language), jalali.jdn_of(now.date()))
    lines.append('')
    lines.append(line('<b>%s</b>  <span alpha="60%%">%s</span>' % (esc(day_title(today_cell, language)), ltr(gregorian_title(today_cell)))))
    for t in today_cell['occasions'][:4]:
        lines.append(line('  ' + esc(t)))
    holidays = [c for w in weeks for c in w['days'] if c['inMonth'] and c['holiday'] and not c['weekend'] and c['occasions']]
    if holidays:
        lines.append('')
        for c in holidays:
            lines.append(line('<span color="%s">%s</span>  %s' % (holiday_color, esc(jalali.localize_digits(str(c['day']).rjust(2), language)),
                                                                 esc(c['occasions'][0]))))
    if offset:
        lines.append('<span alpha="60%">scroll for months · click for today</span>')
    classes = ['holiday'] if today_cell['holiday'] else []
    return {'text': esc(jalali.format_jalali(now, opts['format'], language)), 'tooltip': '\n'.join(lines),
            'class': classes, 'alt': 'holiday' if classes else 'workday'}


SIGNAL = int(os.environ.get('JALALI_CALENDAR_SIGNAL', '9'))


def shift(value):
    if value in ('0', 'today'):
        OFFSET.unlink(missing_ok=True)
    else:
        OFFSET.write_text(str(read_offset() + int(value)))
    # Redraw now rather than at the next tick; matches "signal" in the module.
    subprocess.run(['pkill', '-RTMIN+%d' % SIGNAL, 'waybar'], check=False, capture_output=True)


def convert(text, opts):
    match = re.fullmatch(r'(\d{1,4})[-/.](\d{1,2})[-/.](\d{1,2})', text.strip())
    if not match:
        sys.exit('jalali-calendar: dates look like 1405-08-08 or 2026-10-30')
    y, m, d = (int(x) for x in match.groups())
    if not 1 <= m <= 12:
        sys.exit('jalali-calendar: %s has no month %d' % (text, m))
    if y < 1700:
        if not (1 <= m <= 12 and 1 <= d <= jalali.month_length(y, m - 1)):
            sys.exit('jalali-calendar: %s is not a Jalali date' % text)
        gy, gm, gd = jalali.to_gregorian(y, m - 1, d)
        print('%04d-%02d-%02d' % (gy, gm + 1, gd))
    else:
        try:
            jy, jm, jd = jalali.jalali_for(date(y, m, d))
        except ValueError:
            sys.exit('jalali-calendar: %s is not a Gregorian date' % text)
        print(jalali.localize_digits('%04d-%02d-%02d' % (jy, jm + 1, jd), opts['language']))


def main(argv):
    args, opts = parse_options(argv)
    command = args[0] if args else 'today'
    if command in ('-h', '--help', 'help'):
        print(__doc__.strip())
    elif command == 'today':
        print(jalali.format_jalali(datetime.now(), 'dddd d MMMM yyyy', opts['language']))
    elif command == 'date':
        print(jalali.format_jalali(datetime.now(), args[1] if len(args) > 1 else 'yyyy/MM/dd', opts['language']))
    elif command == 'convert' and len(args) == 2:
        convert(args[1], opts)
    elif command == 'month':
        if len(args) == 3:
            if not (args[1].isdigit() and args[2].isdigit() and 1 <= int(args[2]) <= 12):
                sys.exit('jalali-calendar: month takes a Jalali year and a month 1-12, like: month 1405 8')
            terminal_month(int(args[1]), int(args[2]) - 1, opts)
        else:
            jy, jm, _ = jalali.jalali_for(date.today())
            terminal_month(jy, jm, opts)
    elif command == 'waybar':
        import json
        print(json.dumps(waybar(opts), ensure_ascii=False))
    elif command == 'shift' and len(args) == 2 and re.fullmatch(r'[+-]?\d+|today', args[1]):
        shift(args[1])
    else:
        sys.exit('jalali-calendar: unknown command; try jalali-calendar --help')


if __name__ == '__main__':
    main(sys.argv[1:])
